+// preferOSC52 reports whether copy should go through an OSC 52 escape rather than
+// a local clipboard tool: in SSH, a tmux/zellij multiplexer, or a herdr sandbox,
+// the local tool targets the wrong machine, is intercepted, or is walled off from
+// the display.
+func preferOSC52() bool {
+	return os.Getenv("SSH_CONNECTION") != "" ||
+		os.Getenv("SSH_TTY") != "" ||
+		os.Getenv("TMUX") != "" ||
+		os.Getenv("ZELLIJ") != "" ||
+		os.Getenv("HERDR_ENV") != ""
+}
+
+// copyViaOSC52 copies text to the terminal's clipboard with an OSC 52 escape.
+// This reaches the clipboard of the machine the user is actually looking at,
+// even across SSH, a multiplexer, or a sandbox. The terminal emulator must
+// support OSC 52 (most modern ones do, including iTerm2/Ghostty/WezTerm/foot/
+// kitty); support can't be detected, so a successful write doesn't guarantee the
+// paste buffer was set.
+func copyViaOSC52(text string) error {
+	enc := base64.StdEncoding.EncodeToString([]byte(text))
+
+	// Terminals commonly cap the OSC 52 payload; bail rather than emit a sequence
+	// that gets silently truncated.
+	if len(enc) > 100000 {
+		return fmt.Errorf("content too large for OSC 52 clipboard (%d bytes)", len(text))
+	}
+
+	seq := fmt.Sprintf("\x1b]52;c;%s\x07", enc)
+
+	// tmux only forwards the sequence to the outer terminal when it's wrapped in a
+	// DCS passthrough (and the user has `set-clipboard on`); each inner ESC must
+	// be doubled.
+	if os.Getenv("TMUX") != "" {
+		seq = "\x1bPtmux;" + strings.ReplaceAll(seq, "\x1b", "\x1b\x1b") + "\x1b\\"
+	}
+
+	// Write to the controlling terminal so the escape lands even when stdout is
+	// redirected or piped.
+	tty, err := os.OpenFile("/dev/tty", os.O_WRONLY, 0)
+	if err != nil {
+		return err
+	}
+	defer tty.Close()
+
+	if _, err := tty.WriteString(seq); err != nil {
+		return err
+	}
+
+	return nil
+}
