+		DistributionPoint: uriFullName("https://other.example.com/crl"),
+	}))
+	repo := newIDPTestRepository(t, ca, crlPath)
+
+	locations := &core.CRLLocations{CRLFile: crlPath}
+	chains := core.NewCertificateChains(nil, []*x509.Certificate{ca.cert})
+	_, err := repo.AddCRL(locations, chains)
