+
+// CheckIssuingDistributionPoint processes the issuing distribution point extension (RFC 5280 Section 5.2.5).
+// distributionPointURIs are the URIs the CRL was loaded for (empty if unknown, e.g. a local CRL file).
+// Only complete, direct CRLs covering end entity certificates are accepted.
+func CheckIssuingDistributionPoint(extensions *[]pkix.Extension, distributionPointURIs []string) error {
+	if extensions == nil {
+		return nil
+	}
+	extension := FindExtension(OidCrlExtIssuingDistributionPoint, extensions)
+	if extension == nil {
+		return nil
+	}
+	idp, err := ParseIssuingDistributionPoint(extension.Value)
+	if err != nil {
+		return err
+	}
+	if idp.IndirectCRL {
+		return errors.New("indirect crls are not supported")
+	}
+	if idp.OnlySomeReasons.BitLength > 0 {
+		return errors.New("crls partitioned by revocation reason (onlySomeReasons) are not supported")
+	}
+	if idp.OnlyContainsAttributeCerts {
+		return errors.New("crl only contains attribute certificates")
+	}
+	//revocation is only checked for client (end entity) certificates
+	if idp.OnlyContainsCACerts {
+		return errors.New("crl only contains ca certificates")
+	}
+	if len(idp.DistributionPoint.RelativeName) > 0 {
+		return errors.New("issuing distribution point nameRelativeToCRLIssuer is not supported")
+	}
+	if len(idp.DistributionPoint.FullName) > 0 && len(distributionPointURIs) > 0 {
+		if !issuingDistributionPointMatches(idp, distributionPointURIs) {
+			return fmt.Errorf("issuing distribution point of crl does not match any of %v", distributionPointURIs)
+		}
+	}
+	return nil
+}
+
+func ParseIssuingDistributionPoint(value []byte) (*IssuingDistributionPoint, error) {
+	idp := new(IssuingDistributionPoint)
+	rest, err := asn1.Unmarshal(value, idp)
+	if err != nil {
+		return nil, fmt.Errorf("could not parse issuing distribution point: %v", err)
+	}
+	if len(rest) != 0 {
+		return nil, errors.New("trailing data after issuing distribution point")
+	}
+	return idp, nil
+}
+
+func issuingDistributionPointMatches(idp *IssuingDistributionPoint, distributionPointURIs []string) bool {
+	for _, name := range idp.DistributionPoint.FullName {
+		if name.Class != asn1.ClassContextSpecific || name.Tag != generalNameTagURI {
+			continue
+		}
+		for _, uri := range distributionPointURIs {
+			if string(name.Bytes) == uri {
+				return true
+			}
+		}
+	}
+	return false
+}
