diff --git a/crl/crlrepository/issuingdistributionpoint_test.go b/crl/crlrepository/issuingdistributionpoint_test.go
new file mode 100644
index 0000000000..a5b33c43b5
--- /dev/null
+++ b/crl/crlrepository/issuingdistributionpoint_test.go
@@ -0,0 +1,234 @@
+package crlrepository
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/asn1"
+	"math/big"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/gr33nbl00d/caddy-revocation-validator/config"
+	"github.com/gr33nbl00d/caddy-revocation-validator/core"
+	"github.com/gr33nbl00d/caddy-revocation-validator/crl/crlloader"
+	"github.com/gr33nbl00d/caddy-revocation-validator/crl/crlreader"
+	"github.com/gr33nbl00d/caddy-revocation-validator/crl/crlreader/extensionsupport"
+	"github.com/gr33nbl00d/caddy-revocation-validator/crl/crlstore"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+)
+
+const testCDP = "https://ca.example.com/1.0/crl"
+const revokedSerial = 42
+
+type fileCopyCRLLoaderFactory struct {
+	crlPath string
+}
+
+type fileCopyCRLLoader struct {
+	crlPath string
+}
+
+func (f fileCopyCRLLoaderFactory) CreatePreferredCrlLoader(_ *core.CRLLocations, _ *zap.Logger) (crlloader.CRLLoader, error) {
+	return &fileCopyCRLLoader{f.crlPath}, nil
+}
+
+func (f *fileCopyCRLLoader) LoadCRL(targetFilePath string) error {
+	return copyToTargetFile(f.crlPath, targetFilePath)
+}
+
+func (f *fileCopyCRLLoader) GetCRLLocationIdentifier() (string, error) {
+	return testCRLIdentifier, nil
+}
+
+func (f *fileCopyCRLLoader) GetDescription() string {
+	return "file copy crl loader"
+}
+
+type testCA struct {
+	cert *x509.Certificate
+	key  *ecdsa.PrivateKey
+}
+
+func newTestCA(t *testing.T) *testCA {
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	template := &x509.Certificate{
+		SerialNumber:          big.NewInt(1),
+		Subject:               pkix.Name{CommonName: "Test Intermediate CA"},
+		NotBefore:             time.Now().Add(-time.Hour),
+		NotAfter:              time.Now().Add(time.Hour),
+		KeyUsage:              x509.KeyUsageCertSign | x509.KeyUsageCRLSign,
+		BasicConstraintsValid: true,
+		IsCA:                  true,
+		SubjectKeyId:          []byte{1, 2, 3, 4},
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	require.NoError(t, err)
+	cert, err := x509.ParseCertificate(der)
+	require.NoError(t, err)
+	return &testCA{cert, key}
+}
+
+func (ca *testCA) writeCRL(t *testing.T, extensions ...pkix.Extension) string {
+	template := &x509.RevocationList{
+		Number:     big.NewInt(1),
+		ThisUpdate: time.Now().Add(-time.Minute),
+		NextUpdate: time.Now().Add(time.Hour),
+		RevokedCertificateEntries: []x509.RevocationListEntry{
+			{SerialNumber: big.NewInt(revokedSerial), RevocationTime: time.Now().Add(-time.Minute)},
+		},
+		ExtraExtensions: extensions,
+	}
+	der, err := x509.CreateRevocationList(rand.Reader, template, ca.cert, ca.key)
+	require.NoError(t, err)
+	path := filepath.Join(t.TempDir(), "test.crl")
+	require.NoError(t, os.WriteFile(path, der, 0600))
+	return path
+}
+
+// encoded the way step-ca does it: fullName URI only, always critical
+func idpExtension(t *testing.T, idp extensionsupport.IssuingDistributionPoint) pkix.Extension {
+	value, err := asn1.Marshal(idp)
+	require.NoError(t, err)
+	return pkix.Extension{
+		Id:       asn1.ObjectIdentifier{2, 5, 29, 28},
+		Critical: true,
+		Value:    value,
+	}
+}
+
+func uriFullName(uri string) extensionsupport.DistributionPointName {
+	return extensionsupport.DistributionPointName{
+		FullName: []asn1.RawValue{{Class: asn1.ClassContextSpecific, Tag: 6, Bytes: []byte(uri)}},
+	}
+}
+
+func newIDPTestRepository(t *testing.T, ca *testCA, crlPath string) *Repository {
+	logger := zap.NewNop()
+	crlConfig := &config.CRLConfigParsed{
+		CDPConfigParsed: &config.CDPConfigParsed{
+			CRLFetchModeParsed: config.CRLFetchModeActively,
+			CRLCDPStrict:       true,
+		},
+		SignatureValidationModeParsed: config.SignatureValidationModeVerify,
+		WorkDir:                       t.TempDir(),
+		TrustedSignatureCerts:         []*x509.Certificate{ca.cert},
+	}
+	factory, err := crlstore.CreateStoreFactory(crlstore.Map, crlConfig.WorkDir, logger, "")
+	require.NoError(t, err)
+	return &Repository{factory,
+		&sync.RWMutex{},
+		make(map[string]*Entry),
+		crlConfig,
+		logger,
+		fileCopyCRLLoaderFactory{crlPath},
+		crlreader.StreamingCRLFileReader{},
+	}
+}
+
+func leafCert(ca *testCA, serial int64) *x509.Certificate {
+	return &x509.Certificate{
+		RawIssuer:             ca.cert.RawSubject,
+		SerialNumber:          big.NewInt(serial),
+		CRLDistributionPoints: []string{testCDP},
+	}
+}
+
+func addCRLForCDP(repo *Repository, ca *testCA) (*core.CRLLocations, error) {
+	locations := &core.CRLLocations{CRLDistributionPoints: []string{testCDP}}
+	chains := core.NewCertificateChains(nil, []*x509.Certificate{ca.cert})
+	_, err := repo.AddCRL(locations, chains)
+	return locations, err
+}
+
+func TestStepCALikeCRLWithMatchingIssuingDistributionPointIsAccepted(t *testing.T) {
+	ca := newTestCA(t)
+	crlPath := ca.writeCRL(t, idpExtension(t, extensionsupport.IssuingDistributionPoint{
+		DistributionPoint: uriFullName(testCDP),
+	}))
+	repo := newIDPTestRepository(t, ca, crlPath)
+
+	locations, err := addCRLForCDP(repo, ca)
+	require.NoError(t, err)
+
+	status, err := repo.IsRevoked(leafCert(ca, revokedSerial), locations)
+	require.NoError(t, err)
+	assert.True(t, status.Revoked)
+
+	status, err = repo.IsRevoked(leafCert(ca, revokedSerial+1), locations)
+	require.NoError(t, err)
+	assert.False(t, status.Revoked)
+}
+
+func TestCRLWithMismatchedIssuingDistributionPointIsRejected(t *testing.T) {
+	ca := newTestCA(t)
+	crlPath := ca.writeCRL(t, idpExtension(t, extensionsupport.IssuingDistributionPoint{
+		DistributionPoint: uriFullName("https://other.example.com/crl"),
+	}))
+	repo := newIDPTestRepository(t, ca, crlPath)
+
+	locations, err := addCRLForCDP(repo, ca)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "does not match")
+
+	_, err = repo.IsRevoked(leafCert(ca, revokedSerial+1), locations)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "CRL defined in CDP was not loaded")
+}
+
+func TestIndirectCRLIsRejected(t *testing.T) {
+	ca := newTestCA(t)
+	crlPath := ca.writeCRL(t, idpExtension(t, extensionsupport.IssuingDistributionPoint{
+		DistributionPoint: uriFullName(testCDP),
+		IndirectCRL:       true,
+	}))
+	repo := newIDPTestRepository(t, ca, crlPath)
+
+	locations, err := addCRLForCDP(repo, ca)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "indirect crls are not supported")
+
+	_, err = repo.IsRevoked(leafCert(ca, revokedSerial+1), locations)
+	require.Error(t, err)
+}
