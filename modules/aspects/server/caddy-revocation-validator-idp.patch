@@ -0,0 +1,88 @@
+package extensionsupport
+
+import (
+	"crypto/x509/pkix"
+	"encoding/asn1"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+const testURI = "https://ca.example.com/1.0/crl"
+
+func idpExtensions(t *testing.T, idp IssuingDistributionPoint) *[]pkix.Extension {
+	value, err := asn1.Marshal(idp)
+	require.NoError(t, err)
+	return &[]pkix.Extension{{
+		Id:       asn1.ObjectIdentifier{2, 5, 29, 28},
+		Critical: true,
+		Value:    value,
+	}}
+}
+
+func fullNameURI(uri string) DistributionPointName {
+	return DistributionPointName{
+		FullName: []asn1.RawValue{{Class: asn1.ClassContextSpecific, Tag: generalNameTagURI, Bytes: []byte(uri)}},
+	}
+}
+
+func TestCriticalIssuingDistributionPointIsHandled(t *testing.T) {
+	extensions := idpExtensions(t, IssuingDistributionPoint{DistributionPoint: fullNameURI(testURI)})
+	assert.NoError(t, CheckForCriticalUnhandledCRLExtensions(extensions))
+}
+
+func TestParseIssuingDistributionPointRoundTrip(t *testing.T) {
+	extensions := idpExtensions(t, IssuingDistributionPoint{
+		DistributionPoint:     fullNameURI(testURI),
+		OnlyContainsUserCerts: true,
+	})
+	idp, err := ParseIssuingDistributionPoint((*extensions)[0].Value)
+	require.NoError(t, err)
+	require.Len(t, idp.DistributionPoint.FullName, 1)
+	assert.Equal(t, testURI, string(idp.DistributionPoint.FullName[0].Bytes))
+	assert.True(t, idp.OnlyContainsUserCerts)
+	assert.False(t, idp.IndirectCRL)
+}
+
+func TestParseIssuingDistributionPointRejectsGarbage(t *testing.T) {
+	_, err := ParseIssuingDistributionPoint([]byte{0x01, 0x02})
+	assert.Error(t, err)
+}
+
+func TestCheckIssuingDistributionPoint(t *testing.T) {
+	tests := []struct {
+		name    string
+		idp     IssuingDistributionPoint
+		uris    []string
+		wantErr string
+	}{
+		{"matching uri", IssuingDistributionPoint{DistributionPoint: fullNameURI(testURI)}, []string{"ldap://ignored", testURI}, ""},
+		{"mismatched uri", IssuingDistributionPoint{DistributionPoint: fullNameURI("https://other.example.com/crl")}, []string{testURI}, "does not match"},
+		{"no known uris", IssuingDistributionPoint{DistributionPoint: fullNameURI("https://other.example.com/crl")}, nil, ""},
+		{"no distribution point", IssuingDistributionPoint{OnlyContainsUserCerts: true}, []string{testURI}, ""},
+		{"only user certs", IssuingDistributionPoint{DistributionPoint: fullNameURI(testURI), OnlyContainsUserCerts: true}, []string{testURI}, ""},
+		{"only ca certs", IssuingDistributionPoint{DistributionPoint: fullNameURI(testURI), OnlyContainsCACerts: true}, []string{testURI}, "only contains ca certificates"},
+		{"indirect crl", IssuingDistributionPoint{DistributionPoint: fullNameURI(testURI), IndirectCRL: true}, []string{testURI}, "indirect crls are not supported"},
+		{"only some reasons", IssuingDistributionPoint{DistributionPoint: fullNameURI(testURI), OnlySomeReasons: asn1.BitString{Bytes: []byte{0x40}, BitLength: 2}}, []string{testURI}, "onlySomeReasons"},
+		{"only attribute certs", IssuingDistributionPoint{DistributionPoint: fullNameURI(testURI), OnlyContainsAttributeCerts: true}, []string{testURI}, "attribute certificates"},
+		{"relative name", IssuingDistributionPoint{DistributionPoint: DistributionPointName{RelativeName: pkix.RDNSequence{{{Type: asn1.ObjectIdentifier{2, 5, 4, 3}, Value: "crl1"}}}}}, []string{testURI}, "nameRelativeToCRLIssuer"},
+		{"non uri name", IssuingDistributionPoint{DistributionPoint: DistributionPointName{FullName: []asn1.RawValue{{Class: asn1.ClassContextSpecific, Tag: 2, Bytes: []byte(testURI)}}}}, []string{testURI}, "does not match"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := CheckIssuingDistributionPoint(idpExtensions(t, tt.idp), tt.uris)
+			if tt.wantErr == "" {
+				assert.NoError(t, err)
+			} else {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), tt.wantErr)
+			}
+		})
+	}
+}
+
+func TestCheckIssuingDistributionPointWithoutExtension(t *testing.T) {
+	assert.NoError(t, CheckIssuingDistributionPoint(nil, []string{testURI}))
+	assert.NoError(t, CheckIssuingDistributionPoint(&[]pkix.Extension{}, []string{testURI}))
+}
